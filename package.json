{
  "name": "@dr-co/dsh-skills",
  "version": "0.1.0",
  "description": "Skills page for the DeepSeek Harness Web GUI: one sidebar panel listing every installed skill — your own, the ones bundled inside plugin packages, and plugin-provided ones with no file — with view, edit, rename, enable/disable, download (SKILL.md or the whole folder) and upload.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/host/",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "skill-manager",
    "web-gui"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-skills.git"
  },
  "homepage": "https://github.com/unera/dsh-skills#readme",
  "bugs": {
    "url": "https://github.com/unera/dsh-skills/issues"
  },
  "author": "UNera",
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "^0.25.9",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
